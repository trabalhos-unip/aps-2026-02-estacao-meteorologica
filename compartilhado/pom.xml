<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent><groupId>br.com.aps</groupId><artifactId>estacao-meteorologica</artifactId><version>0.0.1-SNAPSHOT</version></parent>
  <artifactId>compartilhado</artifactId>
  <description>Model (entidade Hibernate), DAO, HibernateUtil e hibernate.cfg.xml usados pelo collector e pelo webapp.</description>
  <dependencies>
    <!-- Hibernate (ORM). Sem Spring: a conexão é criada pelo HibernateUtil a partir do hibernate.cfg.xml -->
    <dependency><groupId>org.hibernate.orm</groupId><artifactId>hibernate-core</artifactId></dependency>
    <!-- Driver JDBC do MySQL -->
    <dependency><groupId>com.mysql</groupId><artifactId>mysql-connector-j</artifactId></dependency>
    <!-- Testes do DAO em banco H2 em memória (modo MySQL), sem precisar de um MySQL rodando -->
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-test</artifactId><scope>test</scope></dependency>
    <dependency><groupId>com.h2database</groupId><artifactId>h2</artifactId><scope>test</scope></dependency>
  </dependencies>
</project>
