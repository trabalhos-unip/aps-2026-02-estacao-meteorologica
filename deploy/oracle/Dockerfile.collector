FROM maven:3.9.11-eclipse-temurin-21 AS build

WORKDIR /workspace
ENV MAVEN_OPTS="-Xmx384m"
COPY pom.xml .
COPY compartilhado/pom.xml compartilhado/pom.xml
COPY collector/pom.xml collector/pom.xml
COPY webapp/pom.xml webapp/pom.xml
RUN mvn -B -pl collector -am dependency:go-offline
COPY compartilhado/src compartilhado/src
COPY collector/src collector/src
RUN mvn -B -pl collector -am package -DskipTests \
    && cp /workspace/collector/target/collector-0.0.1-SNAPSHOT.jar /workspace/collector.jar

FROM eclipse-temurin:21-jre
WORKDIR /app
COPY --from=build /workspace/collector.jar /app/app.jar
ENV JAVA_TOOL_OPTIONS="-Xms64m -Xmx384m"
ENTRYPOINT ["java", "-jar", "/app/app.jar"]
