# Copie este arquivo para .env e altere as senhas
MYSQL_DATABASE=estacao_meteorologica
MYSQL_USER=aps
MYSQL_PASSWORD=defina_uma_senha_local
MYSQL_ROOT_PASSWORD=defina_outra_senha_local
MYSQL_PORT=3306
MYSQL_HOST=localhost

# Opcionais (os valores abaixo já são o padrão)
# OPENMETEO_LATITUDE=-23.5505
# OPENMETEO_LONGITUDE=-46.6333
# COLETA_INTERVALO_MS=10000
# SERVIDOR_PORTA=8080
