# Copie este arquivo para .env e preencha as configurações da sua máquina.
# O arquivo .env é local e nunca deve ser enviado ao Git.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=estacao_meteorologica
MYSQL_USER=aps

# Senha do usuário acima, utilizada pelo collector e pelo webapp.
MYSQL_PASSWORD=

# Opcionais (os valores abaixo já são o padrão)
ESTACAO_NOME=Esta\u00E7\u00E3o Sorocaba
OPENMETEO_LATITUDE=-23.5015
OPENMETEO_LONGITUDE=-47.4526
# COLETA_INTERVALO_MS=10000
# COLETA_MODO=REAL                 (REAL ou SIMULADO)
# COLETA_CENARIO=                  (só no SIMULADO: TEMPO_SECO, CHUVA_FORTE, VENTO_FORTE, DADOS_INCOMPLETOS; vazio = alterna)
# SERVIDOR_PORTA=8080
