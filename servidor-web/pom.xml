<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent><groupId>br.edu.unip.aps</groupId><artifactId>estacao-meteorologica</artifactId><version>0.0.1-SNAPSHOT</version></parent>
  <artifactId>servidor-web</artifactId>
  <description>Aplicação 2: consulta as leituras no MySQL e as entrega ao navegador (Servlet + página HTML/CSS).</description>
  <dependencies>
    <dependency><groupId>br.edu.unip.aps</groupId><artifactId>compartilhado</artifactId><version>${project.version}</version></dependency>
    <!-- Servidor web Tomcat embutido (Servlet), iniciado pelo main -->
    <dependency><groupId>org.apache.tomcat.embed</groupId><artifactId>tomcat-embed-core</artifactId></dependency>
    <!-- Jackson: conversão das leituras para JSON (com suporte a LocalDateTime) -->
    <dependency><groupId>com.fasterxml.jackson.core</groupId><artifactId>jackson-databind</artifactId></dependency>
    <dependency><groupId>com.fasterxml.jackson.datatype</groupId><artifactId>jackson-datatype-jsr310</artifactId></dependency>
    <dependency><groupId>org.mockito</groupId><artifactId>mockito-core</artifactId><scope>test</scope></dependency>
  </dependencies>
  <build>
    <plugins>
      <!-- mvn -pl servidor-web exec:java -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId><artifactId>exec-maven-plugin</artifactId>
        <configuration><mainClass>br.edu.unip.aps.meteorologia.ServidorWebApplication</mainClass></configuration>
      </plugin>
    </plugins>
  </build>
</project>
